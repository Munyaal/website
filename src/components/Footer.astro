            href="https://www.facebook.com/profile.php?id=100064030270572"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary transition-all duration-300"
