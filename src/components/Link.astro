---
type Props = {
  path: string;
  title: string;
  active?: boolean;
  mobile?: boolean;
};

const { path, title, active = false, mobile = false } = Astro.props;
---

<li>
  <a
    href={path}
    class:list={[
      "text-base font-medium transition-all duration-300",
      mobile ? "block py-3 px-4 rounded-lg hover:bg-sand-dark/50" : "hover:text-primary",
      active ? "text-primary" : "text-deep-blue",
    ]}
  >
    {title}
  </a>
</li>