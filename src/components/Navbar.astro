---
import Container from "./Container.astro";
import logo from "../assets/logo.svg";
import Link from "./Link.astro";

const menuItems = [
  {
    title: "Inicio",
    path: "/",
  },
  {
    title: "Quiénes Somos",
    path: "/about",
  },
  {
    title: "Contacto",
    path: "/contact",
  },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 glass">
  <Container>
    <div class="flex justify-between items-center h-20">
      <a href="/" class="flex items-center group">
        <img 
          src={logo.src} 
          class="h-10 transition-transform duration-300 group-hover:scale-105" 
          alt="Munyaal" 
        />
      </a>

      <nav class="hidden md:flex items-center gap-10">
        {menuItems.map(({ title, path }) => (
          <Link
            title={title}
            path={path}
            active={currentPath === path}
          />
        ))}
        <a
          href="/contact"
          class="btn-primary text-sm py-2.5 px-6"
        >
          Hablemos
        </a>
      </nav>

      <button
        id="menu-button"
        class="md:hidden p-2 rounded-lg hover:bg-jade/10 transition-colors duration-300"
        aria-label="Menú"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-6 text-deep-blue"
        >
          <path
            fill-rule="evenodd"
            d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm8.25 5.25a.75.75 0 0 1 .75-.75h8.25a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75Z"
            clip-rule="evenodd"
          />
        </svg>
      </button>
    </div>

    <div id="menu" class="hidden md:hidden pb-4">
      <nav class="flex flex-col gap-2">
        {menuItems.map(({ title, path }) => (
          <Link
            title={title}
            path={path}
            active={currentPath === path}
            mobile
          />
        ))}
        <a
          href="/contact"
          class="btn-primary text-center text-sm py-3 mt-2"
        >
          Hablemos
        </a>
      </nav>
    </div>
  </Container>
</header>

<div class="h-20"></div>

<script>
  const $ = (key: string) => document.querySelector(key);

  const button = $("#menu-button");

  button?.addEventListener("click", () => {
    const menu = $("#menu");
    menu?.classList.toggle("hidden");
  });
</script>