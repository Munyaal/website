---
type Props = {
  delay?: string;
};

const { delay = "0" } = Astro.props;
---

<div class="card group" style={`animation-delay: ${delay}ms;`}>
  <div class="flex items-center gap-4 mb-5">
    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-jade to-jade-dark text-white flex items-center justify-center flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform duration-300">
      <slot name="icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-6"
        >
          <path
            fill-rule="evenodd"
            d="M2.25 6a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V6Zm3.97.97a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1 0 1.06l-2.25 2.25a.75.75 0 0 1-1.06-1.06l1.72-1.72-1.72-1.72a.75.75 0 0 1 0-1.06Zm4.28 4.28a.75.75 0 0 0 0 1.5h3a.75.75 0 0 0 0-1.5h-3Z"
            clip-rule="evenodd"
          />
        </svg>
      </slot>
    </div>
    <h3 class="text-xl font-semibold font-display text-deep-blue">
      <slot name="title">
        Lorem ipsum sit amet consectetur adipisicing elit.
      </slot>
    </h3>
  </div>
  <p class="text-deep-blue/70 leading-relaxed">
    <slot name="content">
      Lorem ipsum dolor, sit amet consectetur adipisicing elit. Delectus,
      nemo mollitia illo soluta omnis ipsam eius! Accusantium odio officiis
      eligendi esse deleniti tenetur earum?
    </slot>
  </p>
</div>