---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import { apiWhatsApp, munyaalPhone } from "~/utils/constants";
---

<Layout title="Contacto - Munyaal">
  <section class="relative pt-24 pb-16 bg-maya-pattern overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-jade/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-maya-blue/10 rounded-full blur-3xl"></div>
    </div>
    
    <Container>
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-display">
          Contáctanos
        </h1>
        <p class="text-lg md:text-xl text-deep-blue/70 leading-relaxed max-w-2xl mx-auto">
          ¿Tienes alguna duda o idea en mente? <span class="text-jade font-semibold">Estamos aquí para ayudarte</span>. Rellena el formulario o escríbenos directamente.
        </p>
      </div>
    </Container>
  </section>

  <section class="section-padding bg-white relative">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 max-w-6xl mx-auto">
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl md:text-3xl font-display mb-4">Hablemos</h2>
            <p class="text-deep-blue/70 text-lg">
              ¿Tienes algún proyecto en mente? Cuéntanos sobre él y encontremos juntos la mejor solución para tu negocio.
            </p>
          </div>

          <div class="space-y-6">
            <a
              href="https://maps.app.goo.gl/LzyqKkyVEBCheLdUA"
              target="_blank"
              rel="noopener"
              class="flex items-start gap-4 p-4 rounded-xl hover:bg-jade/5 transition-colors group"
            >
              <div class="w-12 h-12 rounded-xl bg-jade/10 flex items-center justify-center flex-shrink-0 group-hover:bg-jade group-hover:scale-110 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 text-jade group-hover:text-white">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-deep-blue">Ubicación</p>
                <p class="text-deep-blue/70">Mundo Hábitat, 77714 Playa del Carmen, Q.R.</p>
              </div>
            </a>

            <a
              href="mailto:developers@munyaal.app"
              class="flex items-start gap-4 p-4 rounded-xl hover:bg-jade/5 transition-colors group"
            >
              <div class="w-12 h-12 rounded-xl bg-jade/10 flex items-center justify-center flex-shrink-0 group-hover:bg-jade group-hover:scale-110 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 text-jade group-hover:text-white">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-deep-blue">Email</p>
                <p class="text-deep-blue/70">developers@munyaal.app</p>
              </div>
            </a>

            <a
              href="tel:+529841309862"
              class="flex items-start gap-4 p-4 rounded-xl hover:bg-jade/5 transition-colors group"
            >
              <div class="w-12 h-12 rounded-xl bg-jade/10 flex items-center justify-center flex-shrink-0 group-hover:bg-jade group-hover:scale-110 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 text-jade group-hover:text-white">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-deep-blue">Teléfono</p>
                <p class="text-deep-blue/70">+52 984 130 9862</p>
              </div>
            </a>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8 md:p-10 border border-sand-dark/20">
          <form class="flex flex-col gap-5" id="contact-form">
            <div>
              <label for="name" class="block text-sm font-medium text-deep-blue mb-2">Nombre completo</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Juan Pérez"
                class="w-full px-4 py-3 rounded-lg border border-sand-dark focus:border-jade focus:ring-2 focus:ring-jade/20 transition-all outline-none bg-sand-light"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-deep-blue mb-2">Correo electrónico</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="juan@tuempresa.com"
                class="w-full px-4 py-3 rounded-lg border border-sand-dark focus:border-jade focus:ring-2 focus:ring-jade/20 transition-all outline-none bg-sand-light"
              />
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-deep-blue mb-2">Mensaje</label>
              <textarea
                name="message"
                id="message"
                required
                rows="5"
                placeholder="Cuéntanos sobre tu proyecto..."
                class="w-full px-4 py-3 rounded-lg border border-sand-dark focus:border-jade focus:ring-2 focus:ring-jade/20 transition-all outline-none bg-sand-light resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="btn-primary justify-center mt-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                <path d="M3.478 2.405a.75.75 0 0 0-.926.941l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.61.75.75 0 0 0 0-1.218A44.507 44.507 0 0 1 3.478 2.405Z" />
              </svg>
              Enviar mensaje
            </button>
          </form>
        </div>
      </div>
    </Container>
  </section>
</Layout>

<script>
  const $ = (selector: string) => document.querySelector(selector);

  const contactForm = $("#contact-form");

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formData = new FormData(contactForm as HTMLFormElement);

    const name = formData.get("name");
    const email = formData.get("email");
    const message = formData.get("message");

    const url = `${import.meta.env.PUBLIC_WHATSAPP_API || 'https://api.whatsapp.com/send'}?phone=${import.meta.env.PUBLIC_MUNYAL_PHONE || '5219841309862'}&text=Hola, soy *${name}* (${email}) y me gustaría decirte que: ${message}`;
    window.open(url, "_blank");
  });
</script>