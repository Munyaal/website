---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import FeatureCard from "~/components/FeatureCard.astro";
import ilogs from "~/assets/logos/ilogs.svg";
import luums from "~/assets/logos/luums.svg";
---

<Layout title="Munyaal - Software a la medida">
  <!-- Hero Section -->
  <section class="section-padding pt-12">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: Text Content -->
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-coral/20 text-deep-blue text-sm font-medium animate-fade-in">
            <span class="w-2 h-2 rounded-full bg-coral animate-pulse"></span>
            Software hecho en Playa del Carmen
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight animate-fade-in-up delay-100">
            Transformamos tu Negocio con
            <span class="text-gradient">Software a la Medida</span>
          </h1>

          <p class="text-lg md:text-xl text-deep-blue/70 max-w-xl animate-fade-in-up delay-200">
            Impulsa el crecimiento de tu empresa con soluciones innovadoras,
            diseñadas específicamente para tus necesidades.
          </p>

          <div class="flex flex-wrap gap-4 animate-fade-in-up delay-300">
            <a href="/contact" class="btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                <path d="M10.5 18.75a.75.75 0 0 0 0 1.5h3a.75.75 0 0 0 0-1.5h-3Z" />
                <path fill-rule="evenodd" d="M8.625.75A3.375 3.375 0 0 0 5.25 4.125v15.75a3.375 3.375 0 0 0 3.375 3.375h6.75a3.375 3.375 0 0 0 3.375-3.375V4.125A3.375 3.375 0 0 0 15.375.75h-6.75ZM7.5 4.125C7.5 3.504 8.004 3 8.625 3H9.75v.375c0 .621.504 1.125 1.125 1.125h2.25c.621 0 1.125-.504 1.125-1.125V3h1.125c.621 0 1.125.504 1.125 1.125v15.75c0 .621-.504 1.125-1.125 1.125h-6.75A1.125 1.125 0 0 1 7.5 19.875V4.125Z" clip-rule="evenodd" />
              </svg>
              Contáctanos
            </a>
            <a href="/about" class="px-6 py-3 rounded-lg border-2 border-deep-blue/20 text-deep-blue font-medium hover:border-primary hover:text-primary transition-all duration-300">
              Conócenos
            </a>
          </div>
        </div>

        <!-- Right: Visual Element -->
        <div class="relative animate-fade-in delay-400">
          <div class="absolute inset-0 bg-gradient-to-br from-coral/40 via-primary/20 to-turquoise/30 rounded-3xl blur-2xl"></div>
          
          <!-- Abstract shapes -->
          <div class="absolute top-8 right-8 w-24 h-24 bg-primary/20 rounded-2xl rotate-12"></div>
          <div class="absolute bottom-12 left-4 w-16 h-16 bg-coral/30 rounded-xl -rotate-6"></div>
          <div class="absolute top-1/2 right-4 w-8 h-8 bg-turquoise/40 rounded-full"></div>
          
          <!-- Main card -->
          <div class="relative bg-white/90 backdrop-blur rounded-2xl shadow-2xl p-8 md:p-10 border border-white/50">
            <div class="grid grid-cols-2 gap-6">
              <div class="text-center p-4 rounded-xl bg-sand/50">
                <div class="text-3xl font-bold text-primary mb-1">100%</div>
                <div class="text-sm text-deep-blue/60">Personalizable</div>
              </div>
              <div class="text-center p-4 rounded-xl bg-sand/50">
                <div class="text-3xl font-bold text-coral-dark mb-1">24/7</div>
                <div class="text-sm text-deep-blue/60">Soporte</div>
              </div>
              <div class="text-center p-4 rounded-xl bg-sand/50">
                <div class="text-3xl font-bold text-turquoise mb-1">∞</div>
                <div class="text-sm text-deep-blue/60">Escalable</div>
              </div>
              <div class="text-center p-4 rounded-xl bg-sand/50">
                <div class="text-3xl font-bold text-deep-blue mb-1">🔒</div>
                <div class="text-sm text-deep-blue/60">Seguro</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Features Section -->
  <section class="section-padding bg-white">
    <Container>
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl mb-6">
          Software a la medida
        </h2>
        <p class="text-lg text-deep-blue/60 max-w-2xl mx-auto">
          Soluciones personalizadas que se adaptan perfectamente a los procesos
          únicos de tu empresa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <FeatureCard delay="100">
          <Fragment slot="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path d="M18.75 12.75h1.5a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5ZM12 6a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 12 6ZM12 18a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 12 18ZM3.75 6.75h1.5a.75.75 0 1 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5ZM5.25 18.75h-1.5a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 0 1.5ZM3 12a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 3 12ZM9 3.75a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5ZM12.75 12a2.25 2.25 0 1 1 4.5 0 2.25 2.25 0 0 1-4.5 0ZM9 15.75a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Z" />
            </svg>
          </Fragment>
          <Fragment slot="title">Personalización Total</Fragment>
          <Fragment slot="content">
            Se adapta completamente a los procesos únicos de tu empresa,
            asegurando funcionalidades específicas y eficientes para tu negocio.
          </Fragment>
        </FeatureCard>

        <FeatureCard delay="200">
          <Fragment slot="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path fill-rule="evenodd" d="M15.22 6.268a.75.75 0 0 1 .968-.431l5.942 2.28a.75.75 0 0 1 .431.97l-2.28 5.94a.75.75 0 1 1-1.4-.537l1.63-4.251-1.086.484a11.2 11.2 0 0 0-5.45 5.173.75.75 0 0 1-1.199.19L9 12.312l-6.22 6.22a.75.75 0 0 1-1.06-1.061l6.75-6.75a.75.75 0 0 1 1.06 0l3.606 3.606a12.695 12.695 0 0 1 5.68-4.974l1.086-.483-4.251-1.632a.75.75 0 0 1-.432-.97Z" clip-rule="evenodd" />
            </svg>
          </Fragment>
          <Fragment slot="title">Escalabilidad</Fragment>
          <Fragment slot="content">
            Crece y evoluciona junto a las necesidades de tu empresa,
            permitiendo agregar nuevas características e integraciones fácilmente.
          </Fragment>
        </FeatureCard>

        <FeatureCard delay="300">
          <Fragment slot="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 0 0 0-1.139c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd" />
            </svg>
          </Fragment>
          <Fragment slot="title">Mayor Eficiencia</Fragment>
          <Fragment slot="content">
            Optimiza tareas y recursos, automatizando procesos clave que
            mejoran el rendimiento y productividad de tu equipo de trabajo.
          </Fragment>
        </FeatureCard>

        <FeatureCard delay="400">
          <Fragment slot="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path fill-rule="evenodd" d="M19.902 4.098a3.75 3.75 0 0 0-5.304 0l-4.5 4.5a3.75 3.75 0 0 0 1.035 6.037.75.75 0 0 1-.646 1.353 5.25 5.25 0 0 1-1.449-8.45l4.5-4.5a5.25 5.25 0 1 1 7.424 7.424l-1.757 1.757a.75.75 0 1 1-1.06-1.06l1.757-1.757a3.75 3.75 0 0 0 0-5.304Zm-7.389 4.267a.75.75 0 0 1 1-.353 5.25 5.25 0 0 1 1.449 8.45l-4.5 4.5a5.25 5.25 0 1 1-7.424-7.424l1.757-1.757a.75.75 0 1 1 1.06 1.06l-1.757 1.757a3.75 3.75 0 1 0 5.304 5.304l4.5-4.5a3.75 3.75 0 0 0-1.035-6.037.75.75 0 0 1-.354-1Z" clip-rule="evenodd" />
            </svg>
          </Fragment>
          <Fragment slot="title">Integración Perfecta</Fragment>
          <Fragment slot="content">
            Se conecta sin problemas con sistemas existentes, como ERPs o
            CRMs, para un flujo de trabajo eficiente y sin interrupciones.
          </Fragment>
        </FeatureCard>

        <FeatureCard delay="500">
          <Fragment slot="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd" />
            </svg>
          </Fragment>
          <Fragment slot="title">Seguridad Mejorada</Fragment>
          <Fragment slot="content">
            Proporciona altos estándares de seguridad, diseñados
            específicamente para proteger tus datos empresariales frente a vulnerabilidades externas.
          </Fragment>
        </FeatureCard>

        <FeatureCard delay="600">
          <Fragment slot="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path d="M10.464 8.746c.227-.18.497-.311.786-.394v2.795a2.252 2.252 0 0 1-.786-.393c-.394-.313-.546-.681-.546-1.004 0-.323.152-.691.546-1.004ZM12.75 15.662v-2.824c.347.085.664.228.921.421.427.32.579.686.579.991 0 .305-.152.671-.579.991a2.534 2.534 0 0 1-.921.42Z" />
              <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v.816a3.836 3.836 0 0 0-1.72.756c-.712.566-1.112 1.35-1.112 2.178 0 .829.4 1.612 1.113 2.178.502.4 1.102.647 1.719.756v2.978a2.536 2.536 0 0 1-.921-.421l-.879-.66a.75.75 0 0 0-.9 1.2l.879.66c.533.4 1.169.645 1.821.75V18a.75.75 0 0 0 1.5 0v-.81a4.124 4.124 0 0 0 1.821-.749c.745-.559 1.179-1.344 1.179-2.191 0-.847-.434-1.632-1.179-2.191a4.122 4.122 0 0 0-1.821-.75V8.354c.29.082.559.213.786.393l.415.33a.75.75 0 0 0 .933-1.175l-.415-.33a3.836 3.836 0 0 0-1.719-.755V6Z" clip-rule="evenodd" />
            </svg>
          </Fragment>
          <Fragment slot="title">Retorno de Inversión</Fragment>
          <Fragment slot="content">
            Elimina costos recurrentes de licencias genéricas y maximiza los
            beneficios al contar con un software eficiente y personalizado.
          </Fragment>
        </FeatureCard>
      </div>
    </Container>
  </section>

  <!-- Products Section -->
  <section class="section-padding">
    <Container>
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl mb-6">
          Productos comerciales
        </h2>
        <p class="text-lg text-deep-blue/60 max-w-xl mx-auto">
          Soluciones especializadas para optimizar tu negocio
        </p>
      </div>

      <div class="flex flex-col md:flex-row justify-center items-center gap-8 md:gap-16">
        <a href="/ilogs" class="group relative p-8 rounded-2xl hover:bg-white transition-all duration-300 hover:shadow-lg">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/5 to-coral/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <img src={ilogs.src} alt="iLogs" loading="lazy" class="h-16 relative z-10 group-hover:scale-105 transition-transform" />
        </a>
        <a href="/luums" class="group relative p-8 rounded-2xl hover:bg-white transition-all duration-300 hover:shadow-lg">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/5 to-coral/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <img src={luums.src} alt="luums" loading="lazy" class="h-14 relative z-10 group-hover:scale-105 transition-transform" />
        </a>
      </div>
    </Container>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-deep-blue text-white">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl lg:text-5xl mb-6">
          ¿Listo para transformar tu negocio?
        </h2>
        <p class="text-lg text-white/70 mb-8">
          Hablemos sobre cómo podemos ayudarte a alcanzar tus objetivos
          con soluciones de software personalizadas.
        </p>
        <a href="/contact" class="btn-primary bg-white text-deep-blue hover:bg-sand">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path d="M10.5 18.75a.75.75 0 0 0 0 1.5h3a.75.75 0 0 0 0-1.5h-3Z" />
            <path fill-rule="evenodd" d="M8.625.75A3.375 3.375 0 0 0 5.25 4.125v15.75a3.375 3.375 0 0 0 3.375 3.375h6.75a3.375 3.375 0 0 0 3.375-3.375V4.125A3.375 3.375 0 0 0 15.375.75h-6.75ZM7.5 4.125C7.5 3.504 8.004 3 8.625 3H9.75v.375c0 .621.504 1.125 1.125 1.125h2.25c.621 0 1.125-.504 1.125-1.125V3h1.125c.621 0 1.125.504 1.125 1.125v15.75c0 .621-.504 1.125-1.125 1.125h-6.75A1.125 1.125 0 0 1 7.5 19.875V4.125Z" clip-rule="evenodd" />
          </svg>
          Contáctanos ahora
        </a>
      </div>
    </Container>
  </section>
</Layout>